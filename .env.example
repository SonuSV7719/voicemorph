# VoiceMorph environment (copy to .env; never commit .env)

# --- Engine ---------------------------------------------------------------
# Data root for profiles, models, artifacts (default: ~/.voicemorph)
VOICEMORPH_HOME=

# RVC training command template (see docs/ENGINE.md). Inference works without
# this via rvc-python; training requires the RVC-Project training scripts.
VOICEMORPH_RVC_TRAIN_CMD=

# --- Backend (M3) ---------------------------------------------------------
VOICEMORPH_API_KEY=change-me
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voicemorph
